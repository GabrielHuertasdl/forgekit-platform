# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/forgekit"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-char-min-secret-here"

# Google OAuth (optional in development, required for Google sign-in)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Redis (Phase 3 — not required yet) ───────────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Use test keys (sk_test_..., pk_test_...) in development.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs — create one-time prices in Stripe dashboard for each pack.
# Leave empty to hide that pack from the billing page.
STRIPE_PRICE_STARTER=""   # 100 credits / $0.99
STRIPE_PRICE_PRO=""       # 500 credits / $3.99
STRIPE_PRICE_POWER=""     # 2000 credits / $12.99
